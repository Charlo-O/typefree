{
  "name": "typefree",
  "version": "5.6.0",
  "description": "Desktop dictation app with cloud speech-to-text (OpenAI, Groq, Z.ai)",
  "private": true,
  "scripts": {
    "dev": "cd src && vite",
    "build": "cd src && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "cd src && vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "smoke:tauri-dev": "node scripts/run-tauri-dev-smoke.js",
    "smoke:runtime-probe": "node scripts/run-tauri-dev-smoke.js --runtime-probe",
    "smoke:native-recording": "node scripts/run-tauri-dev-smoke.js --native-recording-smoke",
    "smoke:dictation-pipeline": "node scripts/run-tauri-dev-smoke.js --dictation-pipeline-smoke",
    "smoke:cloud-transcription": "node scripts/run-tauri-dev-smoke.js --cloud-transcription-smoke",
    "smoke:cloud-credential-preflight": "node scripts/run-tauri-dev-smoke.js --cloud-credential-preflight",
    "collect:runtime-smoke-evidence": "node scripts/collect-runtime-smoke-evidence.js",
    "pack:runtime-smoke-evidence": "node scripts/pack-runtime-smoke-evidence.js",
    "import:runtime-smoke-evidence": "node scripts/import-runtime-smoke-evidence.js",
    "handoff:runtime-smoke-evidence": "node scripts/generate-runtime-smoke-handoff.js",
    "verify:runtime-smoke-summaries": "node scripts/verify-runtime-smoke-summaries.js",
    "verify:runtime-smoke-handoff-bundle": "node scripts/verify-runtime-smoke-handoff-bundle.js",
    "test:state": "node scripts/test-dictation-session-machine.js",
    "test:platform": "node scripts/test-platform-command-error.js",
    "test:pipeline": "node scripts/test-dictation-pipelines.js",
    "test:audio-quality": "node scripts/test-audio-quality-contract.js",
    "test:clipboard": "node scripts/test-clipboard-items.js",
    "test:settings": "node scripts/test-settings-schema.js",
    "test:processing-mode-hotkeys": "node scripts/test-processing-mode-hotkeys.js",
    "test:dictation-profiles": "node scripts/test-dictation-profiles.js",
    "test:prompt-studio": "node scripts/test-prompt-studio.js",
    "test:vocabulary-layers": "node scripts/test-vocabulary-layers.js",
    "test:runtime-smoke": "node scripts/test-runtime-smoke-contract.js",
    "test:dictation-timeline": "node scripts/test-dictation-timeline-contract.js",
    "test:privacy-diagnostics": "node scripts/test-privacy-diagnostics.js",
    "test:log-redaction": "node scripts/test-log-redaction.js",
    "test:goal-coverage": "node scripts/test-goal-coverage.js",
    "test:goal-readiness": "node scripts/test-goal-readiness.js",
    "test:runtime-smoke-evidence": "node scripts/test-runtime-smoke-evidence-collector.js",
    "test:runtime-smoke-packager": "node scripts/test-runtime-smoke-evidence-packager.js",
    "test:runtime-smoke-importer": "node scripts/test-runtime-smoke-evidence-importer.js",
    "test:runtime-smoke-handoff": "node scripts/test-runtime-smoke-handoff.js",
    "test:runtime-smoke-handoff-bundle": "node scripts/test-runtime-smoke-handoff-bundle.js",
    "verify:goal-readiness": "node scripts/verify-goal-readiness.js",
    "test:github-workflows": "node scripts/test-github-workflows.js",
    "test:tauri-release-config": "node scripts/test-tauri-release-config.js",
    "test:macos-release-identity": "node scripts/verify-macos-release-identity.js",
    "test:release-signing-policy": "node scripts/test-release-signing-policy.js",
    "test:tauri-dev-smoke-contract": "node scripts/test-tauri-dev-smoke-contract.js",
    "test:transcript-events": "node scripts/test-transcript-event-contract.js",
    "test:tauri-command-boundaries": "node scripts/test-tauri-command-boundaries.js",
    "test:tauri-app-data-migration": "cargo test --manifest-path src-tauri/Cargo.toml app_data_migration --lib",
    "test:tauri-database": "cargo test --manifest-path src-tauri/Cargo.toml commands::database --lib",
    "test:tauri-credentials": "cargo test --manifest-path src-tauri/Cargo.toml commands::credentials --lib && cargo test --manifest-path src-tauri/Cargo.toml commands::settings --lib",
    "test:tauri-command-errors": "cargo test --manifest-path src-tauri/Cargo.toml command_error --lib",
    "test:tauri-log-redaction": "cargo test --manifest-path src-tauri/Cargo.toml commands::logging --lib",
    "test:tauri-audio-quality": "cargo test --manifest-path src-tauri/Cargo.toml audio_quality --lib",
    "test:tauri-clipboard-images": "cargo test --manifest-path src-tauri/Cargo.toml clipboard_images --lib",
    "test:native-recording-contract": "node scripts/test-native-recording-contract.js",
    "test:tauri-provider-contracts": "cargo test --manifest-path src-tauri/Cargo.toml transcription::providers --lib && cargo test --manifest-path src-tauri/Cargo.toml transcription::domain --lib && cargo test --manifest-path src-tauri/Cargo.toml transcription::batch_service --lib",
    "test:tauri-volcengine-protocol": "cargo test --manifest-path src-tauri/Cargo.toml transcription::volcengine::protocol --lib",
    "test:frontend-boundaries": "node scripts/test-frontend-boundaries.js",
    "test:ui-visual-parity": "node scripts/test-ui-visual-parity.js",
    "verify:frontend": "npm run test:frontend-boundaries && npm run test:ui-visual-parity && npm run test:github-workflows && npm run test:goal-coverage && npm run test:goal-readiness && npm run test:runtime-smoke-evidence && npm run test:runtime-smoke-packager && npm run test:runtime-smoke-importer && npm run test:runtime-smoke-handoff && npm run test:runtime-smoke-handoff-bundle && npm run test:transcript-events && npm run typecheck && npm run format:check && npm run test:settings && npm run test:processing-mode-hotkeys && npm run test:dictation-profiles && npm run test:prompt-studio && npm run test:vocabulary-layers && npm run test:runtime-smoke && npm run test:dictation-timeline && npm run test:privacy-diagnostics && npm run test:log-redaction && npm run test:platform && npm run test:state && npm run test:pipeline && npm run test:audio-quality && npm run test:clipboard && npm run build",
    "verify:tauri": "npm run test:tauri-release-config && npm run test:macos-release-identity && npm run test:release-signing-policy && npm run test:tauri-dev-smoke-contract && npm run test:tauri-command-boundaries && npm run test:tauri-app-data-migration && npm run test:tauri-database && npm run test:tauri-credentials && npm run test:tauri-command-errors && npm run test:tauri-log-redaction && npm run test:tauri-audio-quality && npm run test:tauri-clipboard-images && npm run test:native-recording-contract && npm run test:tauri-provider-contracts && npm run test:tauri-volcengine-protocol && cargo check --manifest-path src-tauri/Cargo.toml",
    "prompt:score": "node scripts/prompt-score.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --ignore-path ../.prettierignore --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --ignore-path ../.prettierignore --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "tauri",
    "desktop-app",
    "openai",
    "groq",
    "zhipu"
  ],
  "author": {
    "name": "TypeFree Team",
    "email": "support@typefree.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.10",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.10",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@stylexjs/stylex": "^0.19.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-store": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.518.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.4",
    "ws": "^8.19.0"
  }
}
